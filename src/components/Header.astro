<header class="site-header">
    <a href="/" class="logo" aria-label="Impact Days">
            <!-- <span>IMPACT</span>
            <span>DAYS</span> -->

            <img
                        src="indhold/logo/IDBW.webp"
                        alt="Impact Days logo"
                    >
    </a>

        <nav class="main-nav" id="mainNav">
            <a href="#about">ABOUT</a>
            <a href="/program">FULL PROGRAM</a>
            <a href="#practical">PRACTICAL</a>
            <a href="#tickets">TICKETS</a>
        </nav>

        <!-- <a href="/program" class="text-button"></a> -->

        <div class="header-actions">
            <img
                        src="indhold/some/search.webp"
                        alt="search icon"
                    >

        </div>

        <style>
            header {
    width: 100%;
    height: 74px;

    padding: 12px var(--page-padding);

    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    position: relative;
    z-index: 100;
}


/* Logo */

.logo {
    display: flex;
    flex-direction: column;

    width: 50px;

    font-size: 20px;
    line-height: 0.78;
    font-weight: 900;
    letter-spacing: -1.5px;

    margin-top: 3px;
}

.logo span:first-child {
    color: var(--red);
}

.logo span:last-child {
    color: var(--dark-blue);

    padding-left: 9px;
}


/* Navigation */

.main-nav {
    display: flex;
    align-items: center;
    gap: 27px;

    margin-top: 7px;
    
    font-family: "Noto Sans Normal";
}

.main-nav a {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.2px;

    transition: opacity 0.2s ease;

    
}

.main-nav a:hover {
    opacity: 0.45;
}


/* Header actions */

.header-actions {
    display: flex;
    gap: 18px;
    align-items: center;
}

.header-actions img {
    width: 20px;
    height: 20px;

    object-fit: contain;
}

.search-button,
.menu-button {
    border: 0;
    background: transparent;
    cursor: pointer;
}

.search-button svg {
    width: 20px;
    height: 20px;

    stroke: #111;
    stroke-width: 1.3;
    fill: none;

    margin-top: 3px;
}


/* Hamburger */

.menu-button {
    width: 16px;

    display: none;
    flex-direction: column;
    gap: 4px;
}

.menu-button span {
    width: 100%;
    height: 1px;
    background: #111;
}

@media (max-width: 760px) {
    .site-header {
        align-items: center;
    }

    .main-nav {
        display: none;
        position: absolute;
        top: 74px;
        left: var(--page-padding);
        right: var(--page-padding);
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
        padding: 20px 0;
        background: var(--blue);
    }

    .main-nav.is-open {
        display: flex;
    }

    .menu-button {
        display: flex;
    }
}
        </style>
</header>

