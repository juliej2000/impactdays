<style>
	
/* =====================================================
   HERO
===================================================== */

.hero {
    min-height: 600px;

    display: grid;
    grid-template-columns: 57% 43%;

    position: relative;

   
}


/* Hero content */

.hero-content {
    padding: 10px var(--page-padding) 70px;

    position: relative;
    z-index: 3;

     margin-top: 50px;
}

.eyebrow {
    font-size: 10px;
    line-height: 1.4;

    letter-spacing: 0.65px;
    font-weight: 500;

    text-transform: uppercase;
}


/* Main title */

.hero-title {
    margin-top: 13px;

    display: flex;
    flex-direction: column;

    font-size: clamp(58px, 7.8vw, 115px);
    line-height: 0.74;

    font-weight: 900;
    letter-spacing: -6px;
    text-transform: uppercase;
}

.hero-title span:first-child {
    color: var(--red);
}

.hero-title span:last-child {
    color: var(--dark-blue);

    padding-left: 55px;
}


/* Intro */

.hero-intro {
    margin-top: 28px;

    font-size: 18px;
    font-weight: 500;
    letter-spacing: 0.3px;
}


/* Description */

.hero-description {
    max-width: 230px;

    margin-top: 13px;

    font-size:12px;
    line-height: 1.45;
}


/* Hero buttons */

.hero-buttons {
    display: flex;
    align-items: center;
    gap: 15px;

    margin-top: 22px;
}

.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 40px;

    padding: 0 13px;

    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2px;

    transition:
        transform 0.2s ease,
        background 0.2s ease,
        color 0.2s ease;
}

.button:hover {
    transform: translateY(-2px);
}

.button-dark {
    color: #fff;
    background: var(--black);
}

.button-dark:hover {
    background: var(--red);
}

.button-light {
    color: var(--black);
    background: white;
}

.text-button {
    font-size: 12px;
    font-weight: 600;

    border-bottom: 1px solid #111;

    padding-bottom: 2px;
}


/* Meta */

.hero-meta {
    display: flex;
    gap: 40px;

    margin-top: 43px;
}

.hero-meta div {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.hero-meta span {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
}

.hero-meta strong {
    font-size: 10px;
    font-weight: 500;
}


/* =====================================================
   HERO IMAGE
===================================================== */

.hero-image-wrapper {
    position: relative;

    margin-top: -74px;
    height: 620px;

    overflow: hidden;

    clip-path: polygon(
        13% 0,
        100% 0,
        100% 100%,
        27% 100%
    );
}

.hero-image {
    width: 100%;
    height: 100%;

    position: relative;
}

.hero-image img {
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    filter: saturate(0.9);
}

.hero-image-overlay {
    position: absolute;
    inset: 0;

    background:
        linear-gradient(
            180deg,
            rgba(0, 80, 150, 0.04),
            rgba(0, 0, 0, 0.06)
        );
}


/* Fake direction signs */

.direction-signs {
    position: absolute;

    left: 46%;
    bottom: 90px;

    background: rgba(0, 0, 0, 0.75);

    color: #fff;

    padding: 4px 7px;

    display: flex;
    flex-direction: column;
    gap: 2px;

    font-size: 6px;
    line-height: 1.2;
}


/* =====================================================
   PROGRAM
===================================================== */

.program {
    padding: 20px var(--page-padding) 90px;
}

.program-grid {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 18px 22px;
}


/* Card */

.program-card {
    overflow: hidden;

    position: relative;

    aspect-ratio: 0.72;

    background: #ccc;
}

.program-card a {
    display: block;

    width: 100%;
    height: 100%;

    position: relative;
}

.program-card img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition:
        transform 0.6s cubic-bezier(.2,.7,.2,1),
        filter 0.3s ease;
}

.program-card:hover img {
    transform: scale(1.06);
    filter: brightness(0.85);
}


/* Card gradient */

.program-card::after {
    content: "";

    position: absolute;
    inset: 0;

    pointer-events: none;

    background:
        linear-gradient(
            to bottom,
            transparent 40%,
            rgba(0,0,0,0.7) 100%
        );
}


/* Card content */

.card-content {
    position: absolute;

    z-index: 2;

    left: 12px;
    right: 12px;
    bottom: 12px;

    color: white;
}

.card-category {
    font-size: 6px;
    font-weight: 700;

    letter-spacing: 0.4px;
}

.card-content h2 {
    margin-top: 5px;

    font-size: 12px;
    line-height: 1;

    letter-spacing: -0.3px;

    font-weight: 800;

    text-transform: uppercase;
}


/* =====================================================
   PRACTICAL
===================================================== */

.practical {
    min-height: 450px;

    padding: 90px var(--page-padding);

    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: 80px;

    background: #008fe8;

    color: white;
}

.practical h2 {
    margin-top: 20px;

    max-width: 600px;

    font-size: clamp(45px, 6vw, 90px);
    line-height: 0.85;

    letter-spacing: -4px;
    font-weight: 900;
}

.practical-copy {
    padding-top: 30px;

    max-width: 300px;
}

.practical-copy p {
    font-size: 11px;
    line-height: 1.45;

    margin-bottom: 30px;
}


/* =====================================================
   TICKETS
===================================================== */

.tickets {
    padding: 90px var(--page-padding);

    background: var(--red);

    color: white;
}

.tickets-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.tickets h2 {
    margin: 20px 0 35px;

    font-size: clamp(55px, 8vw, 120px);
    line-height: 0.82;

    letter-spacing: -6px;

    font-weight: 900;
}
</style>