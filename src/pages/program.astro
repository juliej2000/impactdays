<style>
    /* =====================================================
   HERO
===================================================== */

.hero {
    min-height: 600px;

    display: grid;
    grid-template-columns: 57% 43%;

    position: relative;

   
}


/* Hero content */

.hero-content {
    padding: 10px var(--page-padding) 70px;

    position: relative;
    z-index: 3;

     margin-top: 50px;
}

.eyebrow {
    font-size: 12px;
    line-height: 1.4;

    letter-spacing: 1px;
    font-weight: 500;

    text-transform: uppercase;

    font-family: "Noto Sans Normal";

    margin-bottom: 25px;
    margin-left: 4px;
}


/* Main title */

.hero-title {
    margin-top: 13px;

    display: flex;
    flex-direction: column;

    font-size: clamp(58px, 7.8vw, 115px);
    line-height: 0.74;

    font-weight: 900;
    letter-spacing: -6px;
    text-transform: uppercase;

    font-family: "Inter Normal";
}

.hero-title span:first-child {
    color: var(--red);
}

.hero-title span:last-child {
    color: var(--dark-blue);

    padding-left: 55px;
}


/* Intro */

.hero-intro {
    margin-top: 28px;
    margin-bottom: 40px;

    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.3px;

    font-family: "Noto Sans Normal";
}


/* Hero buttons */

.hero-buttons {
    display: flex;
    align-items: center;
    gap: 15px;

    margin-top: 22px;
    
    font-family: "Inter Normal";
    
}

.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 40px;

    padding: 0 13px;

    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2px;

    transition:
        transform 0.2s ease,
        background 0.2s ease,
        color 0.2s ease;
}

.button:hover {
    transform: translateY(-2px);
}

.button-dark {
    color: #fff;
    background: var(--black);
}

.button-dark:hover {
    background: var(--red);
}

.button-light {
    color: var(--black);
    background: white;
}

.text-button {
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: 12px;
    font-weight: 600;

    border-bottom: 1px solid #111;

    padding-bottom: 2px;
}

.date-button.active {
    opacity: 1;
}

.date-button:not(.active) {
    opacity: 0.55;
}


/* =====================================================
   HERO IMAGE
===================================================== */

.hero-image-wrapper {
    position: relative;

    margin-top: -74px;
    height: 620px;

    overflow: hidden;

    clip-path: polygon(
        13% 0,
        100% 0,
        100% 100%,
        27% 100%
    );
}

.hero-image {
    width: 100%;
    height: 100%;

    position: relative;
}

.hero-image img,
.hero-video {
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    filter: saturate(0.9);
}

.hero-image-overlay {
    position: absolute;
    inset: 0;

    background:
        linear-gradient(
            180deg,
            rgba(0, 80, 150, 0.04),
            rgba(0, 0, 0, 0.06)
        );
}

.program-item {
    border-top: 1px solid #8c9aa3;
}

.program-item:last-of-type {
    border-bottom: 1px solid #8c9aa3;
}

/* --------------------
   HEADER
-------------------- */

.program-header {
    width: 100%;
    border: none;
    background: transparent;
    padding: 17px 7px;
    
    display: flex;
    justify-content: space-between;
    align-items: center;

    font-size: 18px;
    font-weight: 700;
    font-family: inherit;

    cursor: pointer;
    color: #1d1d1d;
}

.program-header:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

.icon {
    font-size: 23px;
    font-weight: 400;
}

/* --------------------
   CONTENT
-------------------- */

.program-content {
    display: none;
    padding: 15px 20px;
    background-color: rgba(255, 255, 255, 0.18);

    font-size: 12px;
    line-height: 1.5;
}

.program-item.active .program-content {
    display: block;
}

/* Open category */

.program-item.active .program-header {
    background-color: #b9def5;
}



/* --------------------
   TALKS
-------------------- */

.talks {
    padding: 22px 20px 8px;
}

.event {
    display: grid;
    grid-template-columns: 60px 1fr;

    min-height: 40px;

    border-top: 1px solid #8c9aa3;
}

.event:last-child {
    border-bottom: 1px solid #8c9aa3;
}

.time {
    font-size: 8px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-right: 1px solid #8c9aa3;
}

.event-name {
    display: flex;
    align-items: center;

    padding-left: 36px;

    font-size: 12px;
    letter-spacing: 0.5px;
}

/* --------------------
   TICKET BUTTON
-------------------- */

.tickets {
    display: flex;
    justify-content: center;
    margin-top: 40px;
}

.ticket-button {
    display: inline-block;

    background-color: #1d1d1d;
    color: white;

    padding: 9px 27px;

    font-size: 14px;
    text-decoration: none;

    transition: 0.2s ease;
}

.ticket-button:hover {
    background-color: #444;
}

</style>

<script>
	import "../script/program.js";
</script>