---
import Layout from '../layouts/Layout.astro';
import '../css/main.css'

---

<Layout>
	<main>
	

		     <!-- ================= HERO ================= -->

        <section class="hero" id="about">

            <div class="hero-content">

                <p class="eyebrow">
                    11-12 SEP 2026 / COPENHAGEN
                </p>

                <h1 class="hero-title">
                    <span>FULL</span>
                    <span>PROGRAM</span>
                </h1>

                <p class="hero-intro">
                    Explore the full program here, find your favorites, and make the most of IMPACT DAYS.
                </p>

               

                <div class="hero-buttons">
                    <button type="button" class="button button-dark date-button active" data-day="friday">
                        FRIDAY 11 SEP
                    </button>

                    <button type="button" class="text-button date-button" data-day="saturday">
                        SATURDAY 12 SEP
                    </button>
                </div>

                

            </div>


            <div class="hero-image-wrapper">

                <div class="hero-image">
                    <img
                        src="indhold/heroimg.png"
                        alt="People attending Impact Days"
                    >

                    <div class="hero-image-overlay"></div>

                </div>

            </div>

        </section>

        <section class="program" id="program">

    <!-- ALL -->
    <div class="program-item">
        <button class="program-header">
            <span>ALL</span>
            <span class="icon">+</span>
        </button>

        <div class="program-content">
            <p>All events</p>
        </div>
    </div>

    <!-- MUSIC -->
    <div class="program-item">
        <button class="program-header">
            <span>MUSIC</span>
            <span class="icon">+</span>
        </button>

        <div class="program-content">
            <p>Music events</p>
        </div>
    </div>

    <!-- ART -->
    <div class="program-item">
        <button class="program-header">
            <span>ART</span>
            <span class="icon">+</span>
        </button>

        <div class="program-content">
            <p>Art events</p>
        </div>
    </div>

    <!-- TALKS -->
    <div class="program-item">
        <button class="program-header">
            <span>TALKS</span>
            <span class="icon">+</span>
        </button>

        <div class="program-content talks">

            <div class="event">
                <span class="time" data-friday="16:00" data-saturday="12:00">16:00</span>
                <span class="event-name" data-friday="FUTURE MEDIA (DA)" data-saturday="CREATIVE CITIES (EN)">FUTURE MEDIA (DA)</span>
            </div>

            <div class="event">
                <span class="time" data-friday="16:30" data-saturday="12:30">16:30</span>
                <span class="event-name" data-friday="UNLOCKING LOCAL IMPACT (EN)" data-saturday="DESIGNING FOR CHANGE (EN)">UNLOCKING LOCAL IMPACT (EN)</span>
            </div>

            <div class="event">
                <span class="time" data-friday="17:00" data-saturday="13:00">17:00</span>
                <span class="event-name" data-friday="FUTURE FISHING (EN)" data-saturday="THE POWER OF COMMUNITY (DA)">FUTURE FISHING (EN)</span>
            </div>

            <div class="event">
                <span class="time" data-friday="17:30" data-saturday="13:30">17:30</span>
                <span class="event-name" data-friday="THE IMPACT OF SOUND (EN)" data-saturday="MUSIC AS ACTIVISM (EN)">THE IMPACT OF SOUND (EN)</span>
            </div>

            <div class="event">
                <span class="time" data-friday="18:00" data-saturday="14:00">18:00</span>
                <span class="event-name" data-friday="ACTIVISM THROUGH CRAFT (EN)" data-saturday="FOOD, CULTURE &amp; FUTURE (EN)">ACTIVISM THROUGH CRAFT (EN)</span>
            </div>

        </div>
    </div>

    <!-- WORKSHOPS -->
    <div class="program-item">
        <button class="program-header">
            <span>WORKSHOPS</span>
            <span class="icon">+</span>
        </button>

        <div class="program-content">
            <p>Workshops</p>
        </div>
    </div>

    <!-- FOOD -->
    <div class="program-item">
        <button class="program-header">
            <span>FOOD</span>
            <span class="icon">+</span>
        </button>

        <div class="program-content">
            <p>Food events</p>
        </div>
    </div>

    <!-- INTERACTIVITIES -->
    <div class="program-item">
        <button class="program-header">
            <span>INTERACTIVITIES</span>
            <span class="icon">+</span>
        </button>

        <div class="program-content">
            <p>Interactive events</p>
        </div>
    </div>

    <!-- POETRY -->
    <div class="program-item">
        <button class="program-header">
            <span>POETRY</span>
            <span class="icon">+</span>
        </button>

        <div class="program-content">
            <p>Poetry events</p>
        </div>
    </div>

    <!-- BUTTON -->
    <div class="tickets">
        <a href="#" class="ticket-button">GET TICKETS →</a>
    </div>

</section>
    </main>
</Layout>

<style>
    /* =====================================================
   HERO
===================================================== */

.hero {
    min-height: 600px;

    display: grid;
    grid-template-columns: 57% 43%;

    position: relative;

   
}


/* Hero content */

.hero-content {
    padding: 10px var(--page-padding) 70px;

    position: relative;
    z-index: 3;

     margin-top: 50px;
}

.eyebrow {
    font-size: 10px;
    line-height: 1.4;

    letter-spacing: 0.65px;
    font-weight: 500;

    text-transform: uppercase;

    font-family: "Noto Sans Normal";
}


/* Main title */

.hero-title {
    margin-top: 13px;

    display: flex;
    flex-direction: column;

    font-size: clamp(58px, 7.8vw, 115px);
    line-height: 0.74;

    font-weight: 900;
    letter-spacing: -6px;
    text-transform: uppercase;

    font-family: "Inter Normal";
}

.hero-title span:first-child {
    color: var(--red);
}

.hero-title span:last-child {
    color: var(--dark-blue);

    padding-left: 55px;
}


/* Intro */

.hero-intro {
    max-width: 350px;

    margin-top: 13px;

    font-size:14px;
    line-height: 1.45;

    font-weight: 500;

    font-family: "Noto Sans Normal";
}


/* Hero buttons */

.hero-buttons {
    display: flex;
    align-items: center;
    gap: 15px;

    margin-top: 22px;
    
    font-family: "Inter Normal";
    
}

.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 40px;

    padding: 0 13px;

    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2px;

    transition:
        transform 0.2s ease,
        background 0.2s ease,
        color 0.2s ease;
}

.button:hover {
    transform: translateY(-2px);
}

.button-dark {
    color: #fff;
    background: var(--black);
}

.button-dark:hover {
    background: var(--red);
}

.button-light {
    color: var(--black);
    background: white;
}

.text-button {
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: 12px;
    font-weight: 600;

    border-bottom: 1px solid #111;

    padding-bottom: 2px;
}

.date-button.active {
    opacity: 1;
}

.date-button:not(.active) {
    opacity: 0.55;
}


/* =====================================================
   HERO IMAGE
===================================================== */

.hero-image-wrapper {
    position: relative;

    margin-top: -74px;
    height: 620px;

    overflow: hidden;

    clip-path: polygon(
        13% 0,
        100% 0,
        100% 100%,
        27% 100%
    );
}

.hero-image {
    width: 100%;
    height: 100%;

    position: relative;
}

.hero-image img {
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    filter: saturate(0.9);
}

.hero-image-overlay {
    position: absolute;
    inset: 0;

    background:
        linear-gradient(
            180deg,
            rgba(0, 80, 150, 0.04),
            rgba(0, 0, 0, 0.06)
        );
}

.program-item {
    border-top: 1px solid #8c9aa3;
}

.program-item:last-of-type {
    border-bottom: 1px solid #8c9aa3;
}

/* --------------------
   HEADER
-------------------- */

.program-header {
    width: 100%;
    border: none;
    background: transparent;
    padding: 17px 7px;
    
    display: flex;
    justify-content: space-between;
    align-items: center;

    font-size: 18px;
    font-weight: 700;
    font-family: inherit;

    cursor: pointer;
    color: #1d1d1d;
}

.program-header:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

.icon {
    font-size: 23px;
    font-weight: 400;
}

/* --------------------
   CONTENT
-------------------- */

.program-content {
    display: none;
    padding: 15px 20px;
    background-color: rgba(255, 255, 255, 0.18);
}

.program-item.active .program-content {
    display: block;
}

/* Open category */

.program-item.active .program-header {
    background-color: #b9def5;
}

/* --------------------
   TALKS
-------------------- */

.talks {
    padding: 22px 20px 8px;
}

.event {
    display: grid;
    grid-template-columns: 60px 1fr;

    min-height: 40px;

    border-top: 1px solid #8c9aa3;
}

.event:last-child {
    border-bottom: 1px solid #8c9aa3;
}

.time {
    font-size: 8px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-right: 1px solid #8c9aa3;
}

.event-name {
    display: flex;
    align-items: center;

    padding-left: 36px;

    font-size: 12px;
    letter-spacing: 0.5px;
}

/* --------------------
   TICKET BUTTON
-------------------- */

.tickets {
    display: flex;
    justify-content: center;
    margin-top: 40px;
}

.ticket-button {
    display: inline-block;

    background-color: #1d1d1d;
    color: white;

    padding: 9px 27px;

    font-size: 14px;
    text-decoration: none;

    transition: 0.2s ease;
}

.ticket-button:hover {
    background-color: #444;
}


/* --------------------
   MOBILE
-------------------- */

@media (max-width: 600px) {

    .program {
        padding: 0 10px;
    }

    .program-header {
        padding: 15px 8px;
        font-size: 16px;
    }

    .icon {
        font-size: 21px;
    }

    .program-content {
        padding: 12px;
    }

    .talks {
        padding: 15px 10px 5px;
    }

    .event {
        grid-template-columns: 50px 1fr;
    }

    .event-name {
        padding-left: 18px;
        font-size: 10px;
    }

    .time {
        font-size: 7px;
    }

    .tickets {
        margin-top: 35px;
    }
}

</style>

<script>
	import "../script/program.js";
</script>